{
  "target": {
    "base_url": "http://YOUR_SERVER_HOST:8000/v1",
    "model": "YOUR_MODEL_NAME",
    "api_key": "${LLM_API_KEY}",
    "label": "PLACEHOLDER_ACCELERATOR x8, TP=8",
    "read_timeout_s": 900.0
  },
  "out_dir": "results",
  "metrics_interval_s": 0.0,
  "seed": 20260809,

  "slo": {
    "ttft_ms": 2000.0,
    "tpot_ms": 100.0,
    "stall_itl_ms": 500.0
  },

  "deployment": {
    "engine": "vllm x.y.z",
    "weights_path": "PLACEHOLDER_WEIGHTS_PATH",
    "quantization": "PLACEHOLDER_QUANT",
    "tensor_parallel_size": 8,
    "max_model_len": 32768,
    "max_num_seqs": 32,
    "max_num_batched_tokens": 8192,
    "launch_command": "PLACEHOLDER_LAUNCH_COMMAND"
  },
  "hardware": {
    "accelerator": "PLACEHOLDER_ACCELERATOR",
    "count": 8,
    "memory_per_device_gb": 64,
    "driver": "PLACEHOLDER_DRIVER_VERSION",
    "host_os": "PLACEHOLDER_OS",
    "collector": "PLACEHOLDER_SAMPLER_SCRIPT"
  },

  "scenarios": [
    {
      "name": "sweep",
      "mode": "closed",
      "parallelism": [1, 2, 4, 8, 12, 16, 20, 24, 28, 32],
      "input_tokens": 1024,
      "output_tokens": 128,
      "request_multiplier": 10,
      "warmup_requests": 2,
      "prefix_mode": "unique",
      "ignore_eos": true
    },
    {
      "name": "ctxlen",
      "mode": "closed",
      "parallelism": 4,
      "input_tokens": [8192, 32768],
      "output_tokens": 512,
      "request_multiplier": 10,
      "warmup_requests": 1,
      "prefix_mode": "unique",
      "ignore_eos": true,
      "slo": { "ttft_ms": 10000.0, "tpot_ms": 100.0 }
    },
    {
      "name": "open-loop",
      "mode": "open",
      "request_rate": 1.0,
      "input_tokens": 1024,
      "output_tokens": 128,
      "num_requests": 120,
      "warmup_requests": 2,
      "prefix_mode": "unique",
      "ignore_eos": true
    }
  ]
}
