{
  "target": {
    "base_url": "http://YOUR_SERVER_HOST:8000/v1",
    "model": "YOUR_MODEL_NAME",
    "api_key": "${LLM_API_KEY}",
    "label": "quickstart",
    "connect_timeout_s": 10.0,
    "read_timeout_s": 600.0
  },
  "out_dir": "results",
  "slo": {
    "ttft_ms": 2000.0,
    "tpot_ms": 100.0,
    "stall_itl_ms": 500.0
  },
  "scenarios": [
    {
      "name": "baseline",
      "mode": "closed",
      "parallelism": 1,
      "input_tokens": 1024,
      "output_tokens": 128,
      "request_multiplier": 10,
      "warmup_requests": 2,
      "prefix_mode": "unique",
      "ignore_eos": true
    }
  ]
}
